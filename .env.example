# Copiar a .env (fuera de git) y reemplazar cada change-me. Nunca subir valores reales.
# El backend NO arranca si alguna credencial sigue valiendo "change-me" o si un secreto es demasiado corto
# (ver las reglas de cada variable). El mensaje de error nombra la variable, nunca su valor.
POSTGRES_DB=parqueadero
DB_USER=change-me
# Contrasena de la BD, p. ej.: openssl rand -base64 32
DB_PASSWORD=change-me

# Administrador inicial: solo se usa al arrancar si la tabla "administrador" esta vacia (se guarda el hash BCrypt).
# Despues de creado, cambiar estas variables no cambia la contrasena (y ADMIN_PASSWORD puede quitarse del .env).
# ADMIN_PASSWORD: minimo 12 caracteres, p. ej.: openssl rand -base64 18
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# Secreto del JWT: minimo 32 bytes aleatorios. Generar con: openssl rand -base64 48
# (PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]]))
JWT_SECRET=change-me

# Clave del simulador de camara (cabecera X-Api-Key, rol SISTEMA): minimo 32 bytes. Generar con: openssl rand -hex 32
# Vacia = simulador deshabilitado (nadie se autentica con API key).
CAMARA_API_KEY=change-me

# Origenes permitidos por CORS, separados por comas (sin comodin).
CORS_ORIGENES=http://localhost:5500,http://localhost:3000

SERVER_PORT=8080
# Interfaz del host donde se publica el backend (127.0.0.1 = solo local). 0.0.0.0 expone a la red: usar TLS con proxy.
BIND_ADDRESS=127.0.0.1

# Limite por IP en /api/admin/login, /api/auth/login y /api/auth/activar (opcional; por defecto 10 por minuto).
# Solo detras de un proxy inverso que la sobrescriba: LIMITE_IP_CABECERA=X-Real-IP
# LIMITE_IP_MAX_PETICIONES=10
# LIMITE_IP_VENTANA_SEGUNDOS=60
# LIMITE_IP_CABECERA=

# Solo para correr el backend fuera de Docker (./mvnw spring-boot:run):
# SERVER_ADDRESS=127.0.0.1   (por defecto; 0.0.0.0 solo si hay que exponerlo en la LAN, p. ej. para la app movil)
# DB_URL=jdbc:postgresql://localhost:5432/parqueadero
# OCR_SERVICE_URL=http://localhost:5000
# UPLOAD_DIR=C:/ruta/absoluta/fuera/del/repo/uploads
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
