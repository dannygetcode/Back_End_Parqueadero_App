# Copiar a .env (fuera de git) y reemplazar cada change-me. JWT_SECRET: minimo 32 caracteres aleatorios.
POSTGRES_DB=parqueadero
DB_USER=change-me
DB_PASSWORD=change-me
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me
SPRING_SECURITY_PASSWORD=change-me
SERVER_PORT=8080

# Solo para correr el backend fuera de Docker (./mvnw spring-boot:run):
# DB_URL=jdbc:postgresql://localhost:5432/parqueadero
# OCR_SERVICE_URL=http://localhost:5000
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
